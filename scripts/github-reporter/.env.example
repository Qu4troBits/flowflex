# ─────────────────────────────────────────────────────────────────────────────
# Flowflex — GitHub Issue Reporter · Template de Credenciais
# Copie para .env e preencha com seus valores REAIS.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ─────────────────────────────────────────────────────────────────────────────

# Token clássico do GitHub com scope "repo"
# Crie em: https://github.com/settings/tokens/new
GITHUB_TOKEN=ghp_SEU_TOKEN_AQUI

# Dono da organização/usuário no GitHub
GITHUB_OWNER=Qu4troBits

# Nome exato dos repositórios
GITHUB_REPO_FRONTEND=flowflex
GITHUB_REPO_BACKEND=flow-flex-backend

# Branch onde as issues serão vinculadas
GITHUB_BRANCH=qa-teste-github-issue
